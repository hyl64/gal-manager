# engines whose games run today, so `launch` can be honest about the rest
RUNNABLE = {
    "artemis", "nscripter", "bgi", "kirikiri"}


# ---------------------------------------------------------------------------
# detection
# ---------------------------------------------------------------------------

def scan_folder(path):
    """Return the engine and the evidence for a game folder."""
    try:
        names = os.listdir(path)
    except OSError as e:
        return None, [], [f"无法读取目录: {e}"]
    lowered = [n.lower() for n in names]
    scores = {}
    evidence = {}
    for engine, info in ENGINES.items():
        score = 0
        hits = []
        for pattern, weight in info["signatures"]:
            if pattern.startswith("*."):
                suffix = pattern[1:]
                matched = [n for n in lowered if n.endswith(suffix)]
            else:
                matched = [n for n in lowered if n == pattern.lower()]
            if matched:
                score += weight
                hits.extend(sorted(matched)[:3])
        if score:
            scores[engine] = score
            evidence[engine] = sorted(set(hits))
    if not scores:
        return None, [], []
    best = max(scores, key=lambda e: scores[e])
    return best, evidence[best], []


# ---------------------------------------------------------------------------
# the library
# ---------------------------------------------------------------------------

def load_library():
    try:
        with open(LIBRARY, "r", encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {"games": {}}


def save_library(lib):
    os.makedirs(os.path.dirname(LIBRARY), exist_ok=True)
    tmp = LIBRARY + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(lib, f, ensure_ascii=False, indent=2)
    os.replace(tmp, LIBRARY)


