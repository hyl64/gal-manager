#!/usr/bin/env python3
# gal - the one command for the galgame runtimes built in this tree
#
# Every engine here ships its own binary and its own idea of how to be
# started: OnscripterYuri wants --root, OpenBGI wants the game directory as
# the working directory, and the others are partly built.  This tool hides
# that: it looks at a game folder, works out which engine the folder belongs
# to, keeps the result in a library, and starts the right binary in the right
# way.
#
#   gal engines              what is built and where
#   gal add <dir>            add a game folder to the library
#   gal list                 what is in the library
#   gal info <game>          why the engine was recognised
#   gal launch <game>        start it (--dry-run prints the command)
#   gal remove <game>        drop it from the library
#   gal doctor               check the binaries and the folders
#
# The library is a JSON file under ~/Library/Application Support/gal, so the
# game folders stay where they are.

import argparse
import json
import os
import shutil
import subprocess
import sys
import time

ENGINES_ROOT = os.path.expanduser("~/Documents/gal-engines")
LIBRARY = os.path.expanduser("~/Library/Application Support/gal/library.json")

# ---------------------------------------------------------------------------
# the engines
# ---------------------------------------------------------------------------
#
# Each entry says where its binary is, what a game folder of that engine looks
# like, and how to start it.  "signatures" are (glob, weight) pairs: the
# weight adds up and the engine with the most evidence wins, so a folder that
# only shares one generic name is not mis-filed.

